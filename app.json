{
  "expo": {
    "name": "Opsiyon Hesaplayıcı",
    "slug": "option-calc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "optioncalc",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/app-icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.kaan.optioncalc",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "tr",
        "CFBundleDisplayName": "Opsiyon"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0f1c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kaan.optioncalc"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0f1c",
          "image": "./assets/images/app-splash.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0a0f1c",
    "extra": {
      "eas": {
        "projectId": "7a3bdc56-2e9a-496b-8d53-e2c8d271df8b"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7a3bdc56-2e9a-496b-8d53-e2c8d271df8b"
    },
    "owner": "kaanert"
  }
}

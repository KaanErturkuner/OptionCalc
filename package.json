    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:live": "node test/live.ts",
    "bt:selftest": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON backtest/selftest.mts",
    "bt:compare": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON backtest/compare.mts",
    "bt:fetch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON backtest/fetch.mts",
    "bt:prep": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON backtest/prep.mts",
    "bt:probe": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON backtest/probe.mts",
    "bt:record": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON backtest/record.mts",
    "check": "npm test && npm run typecheck && npm run lint && npm run bt:selftest",
    "bt:live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON backtest/live.mts",
    "bt:replay": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=backtest/replay.defaults.env backtest/replay.mts"

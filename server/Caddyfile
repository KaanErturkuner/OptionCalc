# Caddy: otomatik Let's Encrypt (80 yalnız ACME/yönlendirme, 443 HTTPS). Uygulama yalnızca 127.0.0.1:8787'de dinler.
# Gövde sınırı yola göre: /coach (görüntü base64 ≈ 5,6 MB'a kadar) 7 MB; diğer tüm uçlar 8 KB.
# (Önceki sürüm tüm siteye 8 KB koydu → Koç görüntü yüklemesi Caddy'de 413 alıyordu.)
# Erişim günlüğü: yalnız /coach* → /var/log/caddy/coach-access.log (JSON, 10 MB × 5 döndürme). Başlıklar silinir
# (x-app-key asla yazılmaz). Diğer uçlar loglanmaz (gürültü ve gizlilik). Hatalar JSON {"error": "..."} döner.
# Web sürümü (statik, Expo export): web.162-243-88-42.sslip.io → /opt/optioncalc-flow/web. API'ye CORS izni server/app/http.ts'te.
web.162-243-88-42.sslip.io {
	encode gzip
	header -Server
	root * /opt/optioncalc-flow/web
	try_files {path} /index.html
	file_server
}

162-243-88-42.sslip.io {
	encode gzip
	header -Server

	log coach_access {
		output file /var/log/caddy/coach-access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>headers delete
			}
		}
	}
	@notcoach not path /coach*
	log_skip @notcoach

	handle_errors {
		header Content-Type "application/json; charset=utf-8"
		header Cache-Control "no-store"
		@big expression {http.error.status_code} == 413
		respond @big `{"error":"istek çok büyük (/coach en çok 7 MB; görüntü 4 MB'a kadar)"}` 413
		respond `{"error":"sunucu isteği işleyemedi (HTTP {http.error.status_code})"}` {http.error.status_code}
	}

	handle /coach* {
		request_body {
			max_size 7MB
		}
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		request_body {
			max_size 8KB
		}
		reverse_proxy 127.0.0.1:8787
	}
}
